# Local agent settings, generated by `nool hooks install`.
# Kept out of this public repo: a clone should not silently install
# session hooks into someone's coding agent. Named per-file rather than
# per-directory (matching the Nool repo) so anything else under .claude/
# stays visible to version control.
.claude/settings.json
.codex/hooks.json
